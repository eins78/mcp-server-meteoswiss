{
  "name": "mcp-server-meteoswiss",
  "version": "1.0.0",
  "description": "A Model Context Protocol (MCP) server for MeteoSwiss weather data.",
  "license": "CC0-1.0",
  "author": "Max F. Albrecht <1@178.is>",
  "main": "src/index.ts",
  "type": "module",
  "engines": {
    "node": ">=20.19.0"
  },
  "directories": {
    "doc": "docs",
    "test": "test"
  },
  "scripts": {
    "dev": "nodemon --watch src --ext ts --exec 'tsx src/index.ts'",
    "ci": "pnpm run lint && pnpm run build && pnpm run test",
    "dist": "pnpm run clean && pnpm run build && pnpm run test",
    "lint": "pnpm run lint:ts && pnpm run lint:eslint",
    "fix": "pnpm run lint:eslint --fix",
    "lint:ts": "tsc --noEmit",
    "lint:eslint": "eslint 'src/**/*.{ts,tsx}'",
    "start": "node dist/index.js",
    "dev:inspect": "npx @modelcontextprotocol/inspector http://localhost:3000/mcp",
    "test": "NODE_OPTIONS='--experimental-vm-modules' jest",
    "test:watch": "pnpm run test --watch",
    "test:integration": "NODE_OPTIONS='--experimental-vm-modules' jest test/integration",
    "build": "tsc",
    "dev:docker": "pnpm run build:docker && pnpm run start:docker",
    "build:docker": "docker build -t mcp-server-meteoswiss:dev .",
    "start:docker": "docker run mcp-server-meteoswiss:dev"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/eins78/mcp-server-meteoswiss-data.git"
  },
  "keywords": [
    "mcp",
    "weather",
    "meteoswiss"
  ],
  "bugs": {
    "url": "https://github.com/eins78/mcp-server-meteoswiss-data/issues"
  },
  "homepage": "https://github.com/eins78/mcp-server-meteoswiss-data#readme",
  "dependencies": {
    "@eins78/styles": "^1.0.0",
    "@modelcontextprotocol/sdk": "^1.28.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "cors": "^2.8.6",
    "debug": "^4.4.3",
    "express": "^5.2.1",
    "express-rate-limit": "^7.5.0",
    "jsdom": "^24.1.3",
    "micromark": "^4.0.2",
    "micromark-extension-gfm": "^3.0.0",
    "tsx": "^4.21.0",
    "turndown": "^7.2.2",
    "turndown-plugin-gfm": "^1.0.2",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@eslint/js": "^9.28.0",
    "@modelcontextprotocol/inspector": "^0.14.3",
    "@types/debug": "^4.1.13",
    "@types/jest": "^29.5.14",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^25.5.0",
    "@types/turndown": "^5.0.6",
    "@typescript-eslint/eslint-plugin": "^8.57.2",
    "@typescript-eslint/parser": "^8.57.2",
    "cross-env": "^7.0.3",
    "eslint": "^9.28.0",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-jest": "^28.13.0",
    "eslint-plugin-prettier": "^5.5.5",
    "eslint-plugin-tsdoc": "^0.4.0",
    "eslint-plugin-unused-imports": "^4.4.1",
    "globals": "^16.2.0",
    "jest": "^29.7.0",
    "jest-environment-node": "^29.7.0",
    "mcp-remote": "^0.1.38",
    "nock": "^14.0.11",
    "nodemon": "^3.1.14",
    "prettier": "^3.8.1",
    "ts-jest": "^29.4.6",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@10.12.1+sha512.f0dda8580f0ee9481c5c79a1d927b9164f2c478e90992ad268bbb2465a736984391d6333d2c327913578b2804af33474ca554ba29c04a8b13060a717675ae3ac"
}
