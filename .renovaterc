{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:recommended",
    "group:recommended",
    "group:linters",
    "group:test",
    "group:allNonMajor",
    "workarounds:typesNodeVersioning",
    "workarounds:nodeDockerVersioning",
    ":dependencyDashboard"
  ],
  "assignees": [
    "eins78"
  ],
  "reviewers": [
    "eins78"
  ],
  "schedule": ["* 7-18 * * 5"],
  "timezone": "Europe/Berlin",
  "rebaseWhen": "conflicted",
  "prConcurrentLimit": 5,
  "packageRules": [
    {
      "description": "Restrict Node.js updates (currently v24, prevent v25+ until validated)",
      "matchPackageNames": ["node", "@types/node"],
      "matchDatasources": ["node-version", "npm", "docker"],
      "allowedVersions": "<25",
      "prPriority": 10
    },
    {
      "description": "Require manual approval for major updates via dependency dashboard",
      "matchUpdateTypes": ["major"],
      "dependencyDashboardApproval": true
    },
    {
      "matchFileNames": [
        "package.json"
      ],
      "labels": [
        "dependencies"
      ]
    },
    {
      "matchUpdateTypes": [
        "minor",
        "patch",
        "pin",
        "digest"
      ],
      "automerge": true
    },
    {
      "description": "Pin js-yaml — read-yaml-file@1.1.0 (via @changesets/cli -> @manypkg/get-packages) calls js-yaml.safeLoad, removed in v4. Renovate PR #104 bumped the <3.14.2 override target to v5 and broke `changeset version`. Keep the override at 3.14.2 (security floor + v3 safeLoad). Do not update.",
      "matchPackageNames": ["js-yaml"],
      "enabled": false
    }
  ]
}
