#!/bin/sh
basedir=$(dirname "$(echo "$0" | sed -e 's,\\,/,g')")

case `uname` in
    *CYGWIN*|*MINGW*|*MSYS*)
        if command -v cygpath > /dev/null 2>&1; then
            basedir=`cygpath -w "$basedir"`
        fi
    ;;
esac

if [ -z "$NODE_PATH" ]; then
  export NODE_PATH="/Users/user/CODE/mcp-server-meteoswiss/node_modules/.pnpm/mcp-remote@0.1.38/node_modules/mcp-remote/node_modules:/Users/user/CODE/mcp-server-meteoswiss/node_modules/.pnpm/mcp-remote@0.1.38/node_modules:/Users/user/CODE/mcp-server-meteoswiss/node_modules/.pnpm/node_modules"
else
  export NODE_PATH="/Users/user/CODE/mcp-server-meteoswiss/node_modules/.pnpm/mcp-remote@0.1.38/node_modules/mcp-remote/node_modules:/Users/user/CODE/mcp-server-meteoswiss/node_modules/.pnpm/mcp-remote@0.1.38/node_modules:/Users/user/CODE/mcp-server-meteoswiss/node_modules/.pnpm/node_modules:$NODE_PATH"
fi
if [ -x "$basedir/node" ]; then
  exec "$basedir/node"  "$basedir/../mcp-remote/dist/proxy.js" "$@"
else
  exec node  "$basedir/../mcp-remote/dist/proxy.js" "$@"
fi
