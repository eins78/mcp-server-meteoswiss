<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>li.kiste.meteoswiss-evals-viewer</string>
    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <string>/Users/user/CODE/mcp-server-meteoswiss/packages/meteoswiss-forecast-evals/scripts/start-viewer.sh</string>
    </array>
    <key>EnvironmentVariables</key>
    <dict>
        <key>PATH</key>
        <string>/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin</string>
    </dict>
    <key>RunAtLoad</key>
    <true/>
    <key>KeepAlive</key>
    <true/>
    <key>StandardOutPath</key>
    <string>/Users/user/Library/Logs/meteoswiss-evals-viewer.log</string>
    <key>StandardErrorPath</key>
    <string>/Users/user/Library/Logs/meteoswiss-evals-viewer.log</string>
</dict>
</plist>
